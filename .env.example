# ============================================================
# India Weather Portal - VPS Deployment Configuration
# ============================================================

# Host port exposed on 127.0.0.1 for your VPS reverse proxy (Nginx, Caddy, Cloudflare Tunnel, etc.)
# If 3000 is occupied by another application, change this to any free port (e.g. 3080, 8085)
APP_PORT=3000

# Subdomain assigned to this app (used in your Nginx / Caddy config)
APP_DOMAIN=weather.yourdomain.com

# Internal backend URL used by Next.js rewrites inside Docker
INTERNAL_BACKEND_URL=http://backend:5000

# Node Environment
NODE_ENV=production
